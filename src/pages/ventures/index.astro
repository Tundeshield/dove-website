---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import VentureList from '../../components/VentureList.astro';
import ContactCta from '../../components/ContactCta.astro';
import { ventures, ventureNames, venturesBySector } from '../../data/ventures';

const groups = venturesBySector();
---
<Base title="Our Ventures" description={`The products and businesses Dove is building, including ${ventureNames()}.`}>
  <PageHero
    title="Our ventures"
    intro="Each Dove venture is a product with its own name, users and purpose. Open any of them to see the problem it solves and what it helps with, or go straight to the product."
  />

  <section class="section on-white" aria-label="Ventures">
    <div class="wrap">
      <p class="count">{ventures.length} {ventures.length === 1 ? 'venture' : 'ventures'}{groups.length > 1 ? ` across ${groups.length} sectors` : ''}</p>
      {groups.map((g) => (
        <section class="group" aria-labelledby={`sector-${g.sector.replace(/\W+/g, '-').toLowerCase()}`}>
          <h2 id={`sector-${g.sector.replace(/\W+/g, '-').toLowerCase()}`}>{g.sector}</h2>
          <VentureList ventures={g.items} />
        </section>
      ))}
    </div>
  </section>

  <section class="section--tight next" aria-labelledby="next-heading">
    <div class="wrap next-inner">
      <h2 id="next-heading">What comes next</h2>
      <p class="lede">We are working on future ventures, including products for audiences beyond the church. When they are ready to share, they will appear on this page.</p>
    </div>
  </section>

  <ContactCta heading="Interested in one of our ventures?" text="Tell us what you need, whether you want to use a product, partner with us or explore working together." />
</Base>

<style>
  .count { font-size: var(--step--1); font-weight: 600; color: var(--ink-muted); margin-bottom: var(--space-l); }
  .group + .group { margin-top: var(--space-xl); }
  .group h2 { font-size: var(--step-2); font-variation-settings: 'opsz' 24; margin-bottom: var(--space-s); }
  .next { border-top: 1px solid var(--line); }
  .next-inner { display: grid; gap: var(--space-s); }
  @media (min-width: 56rem) { .next-inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-xl); align-items: baseline; } }
  .next h2 { font-size: var(--step-3); }
</style>
