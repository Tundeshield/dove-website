---
/** Hero for inner pages: a large serif headline and a short introduction. */
interface Props { title: string; intro?: string; }
const { title, intro } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding-block: var(--space-xl) var(--space-xl); border-bottom: 1px solid var(--line); }
  h1 { max-width: 16ch; margin-bottom: var(--space-m); }
  .lede { max-width: 42rem; }
</style>
