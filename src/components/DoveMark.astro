---
/**
 * The Dove mark: a dove carrying an olive branch, drawn in a single weight.
 * `draw` animates the strokes once on load (skipped for reduced motion).
 */
interface Props {
  size?: number | string;
  color?: string;
  accent?: string;
  label?: string;
  draw?: boolean;
  class?: string;
}
const {
  size = 40,
  color = 'currentColor',
  accent = '#B08D4C',
  label,
  draw = false,
  class: className = '',
} = Astro.props;
---
<svg
  class:list={['dove-mark', { 'dove-mark--draw': draw }, className]}
  width={size}
  height={size}
  viewBox="11.5 -2 100 100"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g stroke={color} stroke-width="2.8">
    <path pathLength="1" class="dm-body" d="M30 50 L37 47.5 C40 40 50 38 54 45 C58 53 68 61 86 64 L106 66 L98 72 L106 78 L84 78 C64 78 50 70 44 60 C42 56 40 52 37 51.5 Z" />
    <path pathLength="1" class="dm-wing" d="M56 50 C60 34 74 22 98 18 C96 36 86 52 70 60" />
  </g>
  <circle class="dm-eye" cx="44.5" cy="45" r="1.5" fill={color} />
  <g class="dm-branch" stroke={accent} fill={accent}>
    <path pathLength="1" class="dm-stem" d="M31 51 C27 60 26 68 28 78" fill="none" stroke-width="2.8" />
    <path d="M28.6 61 C22 59 18 62 17 66 C22 67 26 65 28.6 61Z" stroke-width="1" />
    <path d="M27.2 71 C33 69 37 72 37.5 76 C32 76.5 29 74.5 27.2 71Z" stroke-width="1" />
  </g>
</svg>

<style>
  .dove-mark--draw path[pathLength] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: dm-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .dove-mark--draw .dm-wing { animation-delay: 0.7s; animation-duration: 1.2s; }
  .dove-mark--draw .dm-stem { animation-delay: 1.5s; animation-duration: 0.6s; }
  .dove-mark--draw .dm-eye,
  .dove-mark--draw .dm-branch path:not(.dm-stem) {
    opacity: 0;
    animation: dm-fade 0.5s ease forwards;
    animation-delay: 1.9s;
  }
  .dove-mark--draw .dm-eye { animation-delay: 1.3s; }
  @keyframes dm-draw { to { stroke-dashoffset: 0; } }
  @keyframes dm-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .dove-mark--draw path[pathLength] { stroke-dasharray: none; stroke-dashoffset: 0; }
    .dove-mark--draw .dm-eye, .dove-mark--draw .dm-branch path:not(.dm-stem) { opacity: 1; }
  }
</style>
