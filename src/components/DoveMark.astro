---
/**
 * The Dove mark: a dove carrying an olive branch inside an open ring.
 * The ring begins at the wing tip, so the dove appears to draw the circle.
 *
 * variant="ring" (default) is the primary logo.
 * variant="disc" is the compact version for icons and very small sizes.
 * `draw` animates the strokes once on load (skipped for reduced motion).
 */
interface Props {
  size?: number | string;
  variant?: 'ring' | 'disc';
  /** Line colour (ring variant) or disc colour (disc variant). */
  color?: string;
  /** Dove colour inside the disc variant. */
  inner?: string;
  accent?: string;
  /** Stroke weight in viewBox units. Defaults scale with size so small marks stay legible. */
  weight?: number;
  label?: string;
  draw?: boolean;
  class?: string;
}
const {
  size = 40,
  variant = 'ring',
  color = 'currentColor',
  inner = '#F5F1E8',
  accent = '#B08D4C',
  label,
  draw = false,
  class: className = '',
} = Astro.props;

const px = typeof size === 'number' ? size : 400;
const weight = Astro.props.weight ?? (px <= 48 ? 4.6 : px <= 96 ? 3.4 : 2.4);
const ring = variant === 'ring';
const doveScale = ring ? 0.8 : 0.82;
const doveStroke = +(weight / doveScale).toFixed(2);
const doveColor = ring ? color : inner;
const doveTransform = ring
  ? 'translate(60 50) scale(0.8) translate(-61.5 -48)'
  : 'translate(60 59) scale(0.82) translate(-61.5 -48)';
---
<svg
  class:list={['dove-mark', { 'dove-mark--draw': draw }, className]}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {ring
    ? <path pathLength="1" class="dm-ring" d="M89.3 25.9 A45 45 0 1 1 64.5 15.2" stroke={color} stroke-width={weight} />
    : <circle cx="60" cy="60" r="60" fill={color} />}
  <g transform={doveTransform}>
    <g stroke={doveColor} stroke-width={doveStroke}>
      <path pathLength="1" class="dm-body" d="M30 50 L37 47.5 C40 40 50 38 54 45 C58 53 68 61 86 64 L106 66 L98 72 L106 78 L84 78 C64 78 50 70 44 60 C42 56 40 52 37 51.5 Z" />
      <path pathLength="1" class="dm-wing" d="M56 50 C60 34 74 22 98 18 C96 36 86 52 70 60" />
    </g>
    <circle class="dm-eye" cx="44.5" cy="45" r={Math.max(1.5, doveStroke * 0.55)} fill={doveColor} />
    <g class="dm-branch" stroke={accent} fill={accent}>
      <path pathLength="1" class="dm-stem" d="M31 51 C27 60 26 68 28 78" fill="none" stroke-width={doveStroke} />
      <path d="M28.6 61 C22 59 18 62 17 66 C22 67 26 65 28.6 61Z" stroke-width="1" />
      <path d="M27.2 71 C33 69 37 72 37.5 76 C32 76.5 29 74.5 27.2 71Z" stroke-width="1" />
    </g>
  </g>
</svg>

<style>
  /* Draw order: body, wing, then the ring continues from the wing tip, then the branch. */
  .dove-mark--draw path[pathLength] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: dm-draw 1.3s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .dove-mark--draw .dm-wing { animation-delay: 0.6s; animation-duration: 0.9s; }
  .dove-mark--draw .dm-ring { animation-delay: 1.3s; animation-duration: 1.4s; }
  .dove-mark--draw .dm-stem { animation-delay: 1.1s; animation-duration: 0.5s; }
  .dove-mark--draw .dm-eye,
  .dove-mark--draw .dm-branch path:not(.dm-stem) {
    opacity: 0;
    animation: dm-fade 0.5s ease forwards;
    animation-delay: 1.5s;
  }
  .dove-mark--draw .dm-eye { animation-delay: 1s; }
  @keyframes dm-draw { to { stroke-dashoffset: 0; } }
  @keyframes dm-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .dove-mark--draw path[pathLength] { stroke-dasharray: none; stroke-dashoffset: 0; }
    .dove-mark--draw .dm-eye, .dove-mark--draw .dm-branch path:not(.dm-stem) { opacity: 1; }
  }
</style>
